{
  "compilerOptions": {
    // "target": "ES2020",
    // "module": "es2015",
    // "moduleResolution": "node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "src/.spec.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "temp"]
}
